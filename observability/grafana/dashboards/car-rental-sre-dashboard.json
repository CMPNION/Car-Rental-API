        },
        {
            "title": "Frontend - Errors Total",
            "type": "stat",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
            "id": 17,
            "targets": [
                {
                    "expr": "frontend_errors_total",
                    "legendFormat": "errors",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
