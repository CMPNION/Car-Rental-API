                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "decimals": 2
                }
            },
            "options": {
                "legend": { "displayMode": "table", "placement": "right" }
            }
        },
        {
            "title": "Frontend - API Calls (by endpoint)",
            "type": "timeseries",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
            "id": 16,
            "targets": [
                {
                    "expr": "rate(frontend_api_calls_total[5m])",
